# Public URL of this app, exactly as you open it in the browser.
# The OIDC redirect URI is this + /auth/callback
WHEREHOUSE_APP_URL=https://wherehouse.example.com

TZ=Europe/Prague

# ---- Sign-in (OpenID Connect) ----
# Pocket ID: create an OIDC client with callback URL
#   https://wherehouse.example.com/auth/callback
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE is always used).
OIDC_CLIENT_SECRET=
# Label on the login button.
OIDC_PROVIDER_NAME=Pocket ID
# Optional: only members of these groups may sign in (comma separated).
# Not needed if your provider restricts the client to groups (Pocket ID does).
OIDC_ALLOWED_GROUPS=
# Optional: members of these groups are admins. Without it, the first user is admin.
OIDC_ADMIN_GROUPS=
# Skip the login page and go straight to the provider.
OIDC_AUTO_REDIRECT=false

# ---- Other ----
WHEREHOUSE_MAX_UPLOAD_MB=50
# Where uploaded files go (default: /data/files). May be a network share;
# the database in /data must stay on local disk.
#WHEREHOUSE_FILES_DIR=/files
WHEREHOUSE_SESSION_DAYS=30

# ---- Paperless-ngx (optional) ----
# Each person connects with their own API token in Settings.
PAPERLESS_URL=
# Optional token used for admins only; other people never get it.
PAPERLESS_TOKEN=
# If the URL above is internal (e.g. http://paperless:8000), the address
# your browser uses for Paperless links.
PAPERLESS_PUBLIC_URL=

# ---- Reminders ----
# Hour of day (0-23) after which maintenance reminders are sent.
WHEREHOUSE_NOTIFY_HOUR=9
# Hosts non-admins may send to with self-hosted notification services
# (ntfy, Gotify, webhooks, email), e.g. ntfy.sh,ntfy.example.com
WHEREHOUSE_NOTIFY_ALLOWED_HOSTS=
